{
  "name": "@lms/api",
  "version": "0.1.0",
  "private": true,
  "description": "EduCenter LMS — API (NestJS 10 + TypeORM + BullMQ)",
  "scripts": {
    "predev": "pnpm --filter @lms/license-core build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @lms/license-core build",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typeorm": "typeorm-ts-node-commonjs -d typeorm.config.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d typeorm.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d typeorm.config.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d typeorm.config.ts"
  },
  "dependencies": {
    "@lms/license-core": "workspace:*",
    "@nestjs/bullmq": "^10.2.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
