# ============================================================
# EduCenter LMS — API environment (dev)
# Copy sang .env rồi chỉnh cho đúng máy của bạn
# ============================================================
NODE_ENV=development
API_PORT=4001

# PostgreSQL (role lms — xem scripts/dev-env-setup.ps1)
DATABASE_URL=postgresql://lms:lms_dev@127.0.0.1:5432/educ_lms

# Redis (Memurai/Redis local)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT (đổi trước khi production — T017)
JWT_SECRET=dev-only-secret-change-me
JWT_ACCESS_TTL_SECONDS=900        # access token 15 phút (api-spec §1)
JWT_REFRESH_TTL_SECONDS=604800    # refresh cookie 7 ngày
